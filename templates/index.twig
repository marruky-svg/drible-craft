{% extends "_layout" %}

{# Queries no topo: os {% set %} correm antes do layout ser renderizado
   e as variáveis ficam disponíveis em todos os blocks deste template. #}
{% set slides = craft.entries()
  .section('slider')
  .with(['image'])
  .all() %}

{% set articles = craft.entries()
  .section('articles')
  .with(['image'])
  .limit(3)
  .all() %}

{% block styles %}
  {% if slides|length %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
  {% endif %}
{% endblock %}

{% block content %}
  <h1 class="visually-hidden">{{ siteName }}</h1>

  {# ---------- Slider ---------- #}
  {% if slides|length %}
    <section class="hero" aria-label="Destaques">
      <div class="swiper hero__slider">
        <div class="swiper-wrapper">
          {% for slide in slides %}
            {% set image = slide.image.one() %}
            <div class="swiper-slide hero__slide">
              {% if image %}
                <img class="hero__image"
                     src="{{ image.url }}"
                     alt="{{ image.alt ?? '' }}"
                     loading="{{ loop.first ? 'eager' : 'lazy' }}">
              {% endif %}

              <div class="hero__content">
                <div class="container">
                  <h2 class="hero__title">{{ slide.title }}</h2>

                  {% if slide.supportingText %}
                    <p class="hero__text">{{ slide.supportingText }}</p>
                  {% endif %}

                  {% if slide.linkSlide %}
                    <a class="button" href="{{ slide.linkSlide.url }}">
                      {{ slide.linkSlide.getLabel(true) ?: 'Saber mais' }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if slides|length > 1 %}
          <div class="swiper-pagination"></div>
          <div class="swiper-button-prev"></div>
          <div class="swiper-button-next"></div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {# ---------- Artigos ---------- #}
  <section class="articles container">
    <h2 class="section-title">Artigos</h2>

    <div class="articles__grid">
      {% for article in articles %}
        {% set image = article.image.one() %}
        <article class="card">
          {% if image %}
            <img src="{{ image.getUrl({ width: 800, height: 500, mode: 'crop' }) }}"
                 width="800" height="500"
                 alt="{{ image.alt ?? '' }}"
                 loading="lazy">
          {% endif %}
          <div class="card__body">
            <h3 class="card__title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="card__summary">{{ article.summary }}</p>
          </div>
        </article>
      {% else %}
        <p>Ainda não há artigos publicados.</p>
      {% endfor %}
    </div>
  </section>
{% endblock %}

{% block scripts %}
  {% if slides|length > 1 %}
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    {% verbatim %}
    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      new Swiper('.hero__slider', {
        rewind: true,
        speed: reduceMotion ? 0 : 500,
        pagination: { el: '.swiper-pagination', clickable: true },
        navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
        a11y: {
          prevSlideMessage: 'Slide anterior',
          nextSlideMessage: 'Slide seguinte',
          paginationBulletMessage: 'Ir para o slide {{index}}'
        }
      });
    </script>
    {% endverbatim %}
  {% endif %}
{% endblock %}
