{% extends "_layout" %}

{% block title %}{{ entry.title }} – {{ siteName }}{% endblock %}

{% block content %}
  {% set image = entry.image.one() %}

  <article class="article container">
    <a class="back-link" href="{{ siteUrl }}">Voltar à página inicial</a>

    <h1>{{ entry.title }}</h1>
    <p class="article__meta">
      <time datetime="{{ entry.postDate|atom }}">{{ entry.postDate|date('long') }}</time>
    </p>

    {% if image %}
      <img class="article__image"
           src="{{ image.getUrl({ width: 1200 }) }}"
           alt="{{ image.alt ?? '' }}">
    {% endif %}

    <p class="article__summary">{{ entry.summary|nl2br }}</p>
  </article>
{% endblock %}
